rules_version = '2';
// Shane's Fit Tracker — paste this whole file into
// Firebase console → Firestore Database → Rules → Publish.
//
// Existing app traffic is unchanged:
//   users/{uid}  get + set {data, ts, email, widgetKey} by that signed-in user only.
// The iPhone widget reads one hard-to-guess document and cannot list the collection.
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    match /widget/{key} {
      // Single-document reads only. Collection queries (list) stay denied.
      allow get: if true;
      allow list: if false;

      allow create: if request.auth != null
        && request.resource.data.ownerUid == request.auth.uid;

      allow update: if request.auth != null
        && resource.data.ownerUid == request.auth.uid
        && request.resource.data.ownerUid == request.auth.uid;

      allow delete: if request.auth != null
        && resource.data.ownerUid == request.auth.uid;
    }
  }
}
